# Postgres. Em desenvolvimento, `npm run db:start` sobe o container do
# docker-compose.dev.yml com estes valores. Em produção aponte para o Postgres
# compartilhado do droplet, pelo nome do container na rede `internal`:
#   postgres://USUARIO:SENHA@acipec-postgres:5432/acipec_ansp
DATABASE_URL=postgres://ansp:ansp@127.0.0.1:5433/ansp

# Hostname público (produção). Lido pelo compose.traefik.yaml para montar a
# regra de roteamento do Traefik — não é usado pela aplicação.
APP_HOST=ansp.apps.rmsantos.tech
# Variante www do hostname público, caso exista.
APP_HOST_WWW=www.ansp.apps.rmsantos.tech
# Hostname anterior aceito temporariamente pelo Traefik durante migrações de
# domínio. Em uma instalação nova, use o mesmo valor de APP_HOST.
APP_HOST_LEGACY=ansp.apps.rmsantos.tech

# Override opcional usado apenas por `db:generate`/`db:migrate` quando o
# DATABASE_URL do runtime não serve para DDL.
# DATABASE_URL_MIGRATE=

# Segredo da sessão (iron-session) e da assinatura dos tickets de
# upload/download de documentos. Mínimo de 32 caracteres.
# Gere com: openssl rand -base64 48
SESSION_SECRET=troque-este-valor-por-uma-chave-aleatoria-de-48-bytes

# Diretório dos documentos enviados no formulário. Em produção é um volume
# Docker montado em /data/uploads.
STORAGE_DIR=.storage

# Admin criado no bootstrap (`npm run db:bootstrap`, executado no `npm start`).
# Se o email já existir, a senha é preservada.
ADMIN_EMAIL=admin@ansp.org.br
ADMIN_PASSWORD=troque-esta-senha

# Login de desenvolvimento com credenciais fixas (admin@admin.com / admin123),
# sem consultar a tabela admin_users. Ignorado quando NODE_ENV=production.
AUTH_BYPASS=true

# E-mail de boas-vindas enviado após o cadastro de benfeitores. Sem SMTP_HOST
# e SMTP_FROM, o cadastro funciona e o envio fica pendente no painel admin.
# Use a porta 465 com SMTP_SECURE=true ou a porta 587 com STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Arca Nossa Senhora da Providência <contato@arcaprovidencia.com.br>"
